{
	"info": {
		"_postman_id": "e-commerce-product-inventory",
		"name": "E-Commerce Product & Inventory Services",
		"description": "Complete API testing collection for Product Service and Inventory Service",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8090",
			"type": "string"
		},
		{
			"key": "productServiceUrl",
			"value": "http://localhost:8092",
			"type": "string"
		},
		{
			"key": "inventoryServiceUrl",
			"value": "http://localhost:8091",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "YOUR_JWT_TOKEN_HERE",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		},
		{
			"key": "skuCode",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Product Service",
			"item": [
				{
					"name": "1. Create Product (Authenticated - SELLER)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"iPhone 15 Pro Max\",\n  \"description\": \"Latest iPhone with A17 Pro chip and titanium design\",\n  \"price\": 1299.99,\n  \"skuCode\": \"IPHONE-15-PRO-MAX-256GB\",\n  \"category\": \"Electronics\",\n  \"imageUrls\": [\n    \"/api/product/upload/iphone15-front.jpg\",\n    \"/api/product/upload/iphone15-back.jpg\"\n  ],\n  \"stockQuantity\": 50,\n  \"active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/product",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product"]
						},
						"description": "Creates a new product. Requires SELLER authentication. sellerId is extracted from JWT token automatically."
					}
				},
				{
					"name": "2. Get All Products (Public or Seller)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"disabled": true
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/product",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product"]
						},
						"description": "No auth = returns all products (public catalog)\nWith SELLER auth = returns only products of that seller"
					}
				},
				{
					"name": "3. Get Product by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "{{productId}}"]
						},
						"description": "Get a specific product by its ID. Public access allowed."
					}
				},
				{
					"name": "4. Get Products by Category",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/category/Electronics",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "category", "Electronics"]
						},
						"description": "Filter products by category (e.g., Electronics, Clothing, Books)"
					}
				},
				{
					"name": "5. Search Products by Name",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/search?name=iPhone",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "search"],
							"query": [
								{
									"key": "name",
									"value": "iPhone"
								}
							]
						},
						"description": "Search products by name (partial match supported)"
					}
				},
				{
					"name": "6. Update Product",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"iPhone 15 Pro Max - Updated\",\n  \"description\": \"Updated description with new features\",\n  \"price\": 1199.99,\n  \"skuCode\": \"IPHONE-15-PRO-MAX-256GB\",\n  \"category\": \"Electronics\",\n  \"imageUrls\": [\n    \"/api/product/upload/iphone15-updated.jpg\"\n  ],\n  \"stockQuantity\": 75,\n  \"active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/product/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "{{productId}}"]
						},
						"description": "Update an existing product. Requires authentication."
					}
				},
				{
					"name": "7. Delete Product",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/product/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "{{productId}}"]
						},
						"description": "Delete a product. Requires authentication."
					}
				},
				{
					"name": "8. Get Active Products Only",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/active",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "active"]
						},
						"description": "Get only active products (where active = true)"
					}
				},
				{
					"name": "9. Get Products by Price Range",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/price-range?minPrice=100&maxPrice=1500",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "price-range"],
							"query": [
								{
									"key": "minPrice",
									"value": "100"
								},
								{
									"key": "maxPrice",
									"value": "1500"
								}
							]
						},
						"description": "Filter products within a specific price range"
					}
				},
				{
					"name": "10. Get Low Stock Products",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/product/low-stock?threshold=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "low-stock"],
							"query": [
								{
									"key": "threshold",
									"value": "20"
								}
							]
						},
						"description": "Get products with stock quantity below the threshold (default: 10)"
					}
				},
				{
					"name": "11. Get Products by Seller ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/seller/SELLER_ID_HERE",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "seller", "SELLER_ID_HERE"]
						},
						"description": "Get all products belonging to a specific seller"
					}
				},
				{
					"name": "12. Upload Single Product Image",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/product/upload",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "upload"]
						},
						"description": "Upload a single product image. Returns file URL to use in product creation."
					}
				},
				{
					"name": "13. Upload Multiple Product Images",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": []
								},
								{
									"key": "files",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/product/upload/multiple",
							"host": ["{{baseUrl}}"],
							"path": ["api", "product", "upload", "multiple"]
						},
						"description": "Upload multiple product images at once"
					}
				}
			]
		},
		{
			"name": "Inventory Service",
			"item": [
				{
					"name": "1. Create Inventory",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"skuCode\": \"IPHONE-15-PRO-MAX-256GB\",\n  \"quantity\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/inventory",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory"]
						},
						"description": "Create a new inventory record for a product SKU"
					}
				},
				{
					"name": "2. Check Stock (Multiple SKUs)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory?skuCode=IPHONE-15-PRO-MAX-256GB&skuCode=SAMSUNG-S24-ULTRA",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory"],
							"query": [
								{
									"key": "skuCode",
									"value": "IPHONE-15-PRO-MAX-256GB"
								},
								{
									"key": "skuCode",
									"value": "SAMSUNG-S24-ULTRA"
								}
							]
						},
						"description": "Check stock availability for multiple SKU codes (used by product service)"
					}
				},
				{
					"name": "3. Get All Inventory",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/all",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "all"]
						},
						"description": "Get all inventory records"
					}
				},
				{
					"name": "4. Get Inventory by SKU Code",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/{{skuCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "{{skuCode}}"]
						},
						"description": "Get inventory details for a specific SKU code"
					}
				},
				{
					"name": "5. Update Inventory",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"skuCode\": \"IPHONE-15-PRO-MAX-256GB\",\n  \"quantity\": 150\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/inventory/{{skuCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "{{skuCode}}"]
						},
						"description": "Update inventory quantity for a SKU code"
					}
				},
				{
					"name": "6. Delete Inventory",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/{{skuCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "{{skuCode}}"]
						},
						"description": "Delete an inventory record"
					}
				},
				{
					"name": "7. Increase Stock",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/{{skuCode}}/increase?quantity=50",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "{{skuCode}}", "increase"],
							"query": [
								{
									"key": "quantity",
									"value": "50"
								}
							]
						},
						"description": "Increase stock quantity by specified amount (e.g., restocking)"
					}
				},
				{
					"name": "8. Decrease Stock",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/{{skuCode}}/decrease?quantity=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "{{skuCode}}", "decrease"],
							"query": [
								{
									"key": "quantity",
									"value": "10"
								}
							]
						},
						"description": "Decrease stock quantity by specified amount (e.g., after sale)"
					}
				},
				{
					"name": "9. Get Low Stock Items",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/low-stock?threshold=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "low-stock"],
							"query": [
								{
									"key": "threshold",
									"value": "20"
								}
							]
						},
						"description": "Get inventory items with quantity below threshold (default: 10)"
					}
				},
				{
					"name": "10. Get Out of Stock Items",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/inventory/out-of-stock",
							"host": ["{{baseUrl}}"],
							"path": ["api", "inventory", "out-of-stock"]
						},
						"description": "Get all inventory items with zero quantity"
					}
				}
			]
		}
	]
}
